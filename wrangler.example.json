{
  "name": "fridge-rescue",
  "main": "address_worker.mjs",
  "compatibility_date": "2026-10-17",
  "workers_dev": true,
  "preview_urls": false,
  "keep_vars": true,
  "assets": {
    "directory": "./cloudflare-pages",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/backend-address"
    ]
  },
  "kv_namespaces": [
    {
      "binding": "ADDRESS_BOOK",
      "id": "REPLACE_WITH_YOUR_KV_NAMESPACE_ID"
    }
  ]
}